---
import { site } from "../site";

interface Props {
  current?: "home" | "blog";
}

const { current = "home" } = Astro.props;
const prefix = current === "home" ? "" : "/";

const links = [
  { href: `${prefix}#sobre`, label: "Sobre" },
  { href: `${prefix}#missao`, label: "Missão" },
  { href: `${prefix}#visao`, label: "Visão" },
  { href: `${prefix}#valores`, label: "Valores" },
  { href: `${prefix}#servicos`, label: "Serviços" },
  { href: `${prefix}#metodo`, label: "Método" },
  { href: "/blog", label: "Blog", current: current === "blog" },
] as const;
---

<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="wordmark" href={current === "home" ? "#topo" : "/"}>
      {site.brand}
    </a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[{ "is-current": "current" in link && link.current }]}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-sm" href={`${prefix}#contato`}>Falar conosco</a>
    </nav>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-mobile"
      data-nav-toggle
    >
      <span class="sr-only">Abrir menu</span>
      <span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href={`${prefix}#contato`}>Falar conosco</a>
  </div>
</header>
