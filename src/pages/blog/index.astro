---
import Base from "../../layouts/Base.astro";
import { formatDate, site } from "../../site";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<Base
  current="blog"
  title={`Blog · ${site.company}`}
  description={`Notas da ${site.company} sobre software, consultoria e o trabalho de entender o problema antes da solução.`}
>
  <main id="conteudo">
    <section class="page-hero">
      <div class="shell">
        <h1 class="reveal">Blog</h1>
        <p class="reveal">
          Notas da {site.company} sobre engenharia, consultoria e o ofício de
          entregar a solução certa para o momento.
        </p>
      </div>
    </section>

    <section class="section blog-index">
      <div class="shell">
        {
          posts.length === 0 ? (
            <p class="empty-blog">Nenhum post publicado ainda.</p>
          ) : (
            <div class="post-list">
              {posts.map((post) => (
                <article class="post-item reveal">
                  <p class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate, post.data.lang)}
                    </time>
                  </p>
                  <h2>
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h2>
                  <p>{post.data.description}</p>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</Base>
